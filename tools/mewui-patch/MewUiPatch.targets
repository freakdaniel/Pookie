<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Pookie.App' or '$(MSBuildProjectName)' == 'Pookie.App.SmokeTests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)MewUiPatch.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" OutputItemType="PookieMewUiPatcher" />
  </ItemGroup>
  <Target Name="PatchPookieMewUiX11" AfterTargets="ResolveReferences"
          Condition="('$(MSBuildProjectName)' == 'Pookie.App' or '$(MSBuildProjectName)' == 'Pookie.App.SmokeTests') and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <PookieMewUiOriginal Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Aprillz.MewUI.Backend.MewVG.X11.dll'" />
    </ItemGroup>
    <PropertyGroup>
      <PookieMewUiPatched>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)patched/Aprillz.MewUI.Backend.MewVG.X11.dll</PookieMewUiPatched>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)mewui-patch-references.txt" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Condition="'@(PookieMewUiOriginal)' != ''" Command="dotnet &quot;@(PookieMewUiPatcher->'%(FullPath)')&quot; &quot;@(PookieMewUiOriginal)&quot; &quot;$(PookieMewUiPatched)&quot; &quot;$(IntermediateOutputPath)mewui-patch-references.txt&quot;" />
    <ItemGroup Condition="'@(PookieMewUiOriginal)' != ''">
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)%(Extension)' == 'Aprillz.MewUI.Backend.MewVG.X11.dll'" />
      <ReferencePath Include="$(PookieMewUiPatched)" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)%(Extension)' == 'Aprillz.MewUI.Backend.MewVG.X11.dll'" />
      <ReferencePathWithRefAssemblies Include="$(PookieMewUiPatched)" />
      <ReferenceCopyLocalPaths Remove="@(PookieMewUiOriginal)" />
      <ReferenceCopyLocalPaths Include="$(PookieMewUiPatched)" />
    </ItemGroup>
  </Target>
</Project>
