<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pookie</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux-'))">
    <DefineConstants>$(DefineConstants);POOKIE_LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">
    <DefineConstants>$(DefineConstants);POOKIE_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">
    <DefineConstants>$(DefineConstants);POOKIE_MACOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Auth/login-capture.js" />
    <EmbeddedResource Include="Auth/browser-requests.js" />
    <EmbeddedResource Include="Assets/Icons/*.svg" />
    <EmbeddedResource Include="Assets/logo.svg" />
    <None Include="Assets/Icons/LICENSE" Link="licenses/Phosphor/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
    <PackageReference Include="InfiniLore.InfiniFrame" Version="0.62.1" />
    <ProjectReference Include="../Pookie.SoundCloud/Pookie.SoundCloud.csproj" />
    <ProjectReference Include="../Pookie.Audio/Pookie.Audio.csproj" />
    <ProjectReference Include="../Pookie.Discord/Pookie.Discord.csproj" />
    <None Include="../../LICENSE" Link="licenses/Pookie/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
