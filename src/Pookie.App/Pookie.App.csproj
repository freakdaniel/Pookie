<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pookie</AssemblyName>
    <ApplicationIcon>Assets/Branding/app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="InfiniLore.InfiniFrame" Version="0.62.1" Condition="'$(PublishAot)' != 'true'" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <Import Project="Pookie.App.Shared.props" />
  <PropertyGroup Condition="('$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
</Project>
