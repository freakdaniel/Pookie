<Project>
  <!-- Both hosts use the same application dependencies and embedded resources. -->
  <PropertyGroup>
    <RootNamespace>Pookie.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Import Project="Pookie.App.Platform.props" />
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Browser/Scripts/login-capture.js" LogicalName="Pookie.App.Browser.Scripts.login-capture.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Browser/Scripts/browser-requests.js" LogicalName="Pookie.App.Browser.Scripts.browser-requests.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Browser/Scripts/browser-audio.js" LogicalName="Pookie.App.Browser.Scripts.browser-audio.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Browser/Scripts/audio-normalization.js" LogicalName="Pookie.App.Browser.Scripts.audio-normalization.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Browser/Filtering/blacklist.json" LogicalName="Pookie.App.Browser.Filtering.blacklist.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/Icons/*.svg" LogicalName="Pookie.App.Assets.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/Stickle/*.png" LogicalName="Pookie.App.Assets.Stickle.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/logo.svg" LogicalName="Pookie.App.Assets.logo.svg" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/Branding/*" LogicalName="Pookie.App.Assets.Branding.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/Fonts/GoogleSans.ttf" LogicalName="Pookie.App.Assets.Fonts.GoogleSans.ttf" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets/Fonts/Bungee-Regular.ttf" LogicalName="Pookie.App.Assets.Fonts.Bungee-Regular.ttf" />

    <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="SoundFlow" Version="1.4.1" GeneratePathProperty="true" />
    <PackageReference Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" GeneratePathProperty="true" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
    <PackageReference Include="LibSMTC" Version="1.1.0" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />

    <InternalsVisibleTo Include="Pookie.Audio.Tests" />
    <InternalsVisibleTo Include="Pookie.Discord.Tests" />
    <InternalsVisibleTo Include="Pookie.App.SmokeTests" />

    <ProjectReference Include="$(MSBuildThisFileDirectory)../Pookie.SoundCloud/Pookie.SoundCloud.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Pookie.Recommendations/Pookie.Recommendations.csproj" />
  </ItemGroup>
</Project>
