<Project>
  <!-- Application and its assembly-level tests must use the same platform TFM. -->
  <PropertyGroup Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or ('$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-')))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux-'))">
    <DefineConstants>$(DefineConstants);POOKIE_LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win-'))">
    <DefineConstants>$(DefineConstants);POOKIE_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx-'))">
    <DefineConstants>$(DefineConstants);POOKIE_MACOS</DefineConstants>
  </PropertyGroup>
</Project>
