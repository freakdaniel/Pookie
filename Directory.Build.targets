<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Pookie.App'">
    <None Include="$(MSBuildThisFileDirectory)licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)REUSE.toml" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Pookie.App' or '$(MSBuildProjectName)' == 'Pookie.App.SmokeTests'">
    <PookieDependencyLicense Include="$(PkgSoundFlow)/LICENSE.md;$(PkgSoundFlow)/SOUNDFLOW-THIRD-PARTY-NOTICES.txt;$(PkgSoundFlow_Codecs_FFMpeg)/LICENSE.md;$(PkgSoundFlow_Codecs_FFMpeg)/SOUNDFLOW-THIRD-PARTY-NOTICES.txt" />
    <PookieDependencyLicense Include="$(MSBuildThisFileDirectory)licenses/LGPL-2.1-or-later.txt" />
    <None Include="$(IntermediateOutputPath)THIRD-PARTY-NOTICES.txt" Link="licenses/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GeneratePookieThirdPartyNotices"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(MSBuildProjectName)' == 'Pookie.App' or '$(MSBuildProjectName)' == 'Pookie.App.SmokeTests'">
    <Error Condition="!Exists('%(PookieDependencyLicense.Identity)')"
           Text="Missing dependency license: %(PookieDependencyLicense.Identity). Restore packages and check their licensing files before distributing Pookie." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ReadLinesFromFile File="$(PkgSoundFlow)/LICENSE.md">
      <Output TaskParameter="Lines" ItemName="SoundFlowLicenseLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(PkgSoundFlow)/SOUNDFLOW-THIRD-PARTY-NOTICES.txt">
      <Output TaskParameter="Lines" ItemName="SoundFlowNoticeLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(PkgSoundFlow_Codecs_FFMpeg)/LICENSE.md">
      <Output TaskParameter="Lines" ItemName="SoundFlowFfmpegLicenseLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(PkgSoundFlow_Codecs_FFMpeg)/SOUNDFLOW-THIRD-PARTY-NOTICES.txt">
      <Output TaskParameter="Lines" ItemName="SoundFlowFfmpegNoticeLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)licenses/LGPL-2.1-or-later.txt">
      <Output TaskParameter="Lines" ItemName="LibVlcLicenseLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(IntermediateOutputPath)THIRD-PARTY-NOTICES.txt"
                      Lines="SoundFlow LICENSE.md;@(SoundFlowLicenseLines);SoundFlow SOUNDFLOW-THIRD-PARTY-NOTICES.txt;@(SoundFlowNoticeLines);SoundFlow.Codecs.FFMpeg LICENSE.md;@(SoundFlowFfmpegLicenseLines);SoundFlow.Codecs.FFMpeg SOUNDFLOW-THIRD-PARTY-NOTICES.txt;@(SoundFlowFfmpegNoticeLines);VideoLAN LibVLCSharp 3.10.2 and Windows LibVLC 3.0.24;Source: https://code.videolan.org/videolan/LibVLCSharp and https://code.videolan.org/videolan/vlc/-/tree/3.0.24;@(LibVlcLicenseLines)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
